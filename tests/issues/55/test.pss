/*!
@weakgroup      issue
@{
@file
@author         Luther Lee
@data           2026/10/29
@brief          Test issue 55: the constraints of a struct hold for every element of a rand struct array
                and for a struct nested in a rand struct.


---------------------------------------------------------------------------------------------------

### Test Command
@code{.unparsed}
make
@endcode

@cond
*/

component pss_top {
    struct pair_s {
        rand bit [4] x;
        rand bit [4] y;
        constraint x < y;
    }
    struct outer_s {
        rand pair_s inner;
        rand bit [4] z;
        constraint z > 12;
    }
    action root_a {
        rand pair_s  one;
        rand pair_s  ps[3];
        rand outer_s o;
        exec body ASM =
        """
            one   = {{one.x}} < {{one.y}}
            ps[0] = {{ps[0].x}} < {{ps[0].y}}
            ps[1] = {{ps[1].x}} < {{ps[1].y}}
            ps[2] = {{ps[2].x}} < {{ps[2].y}}
            o     = {{o.inner.x}} < {{o.inner.y}}, z = {{o.z}}
        """;
    }
}

/**@}*/
