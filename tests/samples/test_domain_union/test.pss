// PSS 2.0 8.2.1 d): the domain of a type is the union of its items, open-ended ones included.
component pss_top {
    action root_a {
        rand bit[8] in [1..3, 250..] x;
        rand int in [..-5, 5..] y;
        rand bit[8] in [..2, 10..12, 250..] z;
        bit ok = 0;
        exec post_solve {
            if ((x <= 3 || x >= 250) && x >= 1 && (y <= -5 || y >= 5) && (z <= 2 || (z >= 10 && z <= 12) || z >= 250)) {
                ok = 1;
            }
        }
        exec body ASM = """ok={{ok}}""";
    }
}
