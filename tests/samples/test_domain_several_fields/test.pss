// PSS 2.0 8.2.1 e): the value domain of a type constrains every field of the declaration.
component pss_top {
    action root_a {
        rand bit[8] in [1..3] a, b, c;
        rand bit[8] in [250..] d, e;
        rand int[16] in [..-100] f, g;
        exec body ASM = """a={{a}} b={{b}} c={{c}} d={{d}} e={{e}} f={{f}} g={{g}}""";
    }
}
