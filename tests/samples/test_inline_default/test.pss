// PSS 2.0 17.1.3, 17.1.10: a default constraint of an in-line with block applies to that traversal only.
component pss_top {
    action sub_a {
        rand bit[4] w;
        exec body ASM = """w={{w}}""";
    }
    action root_a {
        rand bit[4] w;
        activity {
            do sub_a with { default w == 4; };
            do sub_a with { w == 9; };
        }
        constraint {
            w == 11;
        }
        exec header ASM = """root w={{w}}""";
    }
}
