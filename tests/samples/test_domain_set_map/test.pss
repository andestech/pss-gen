// PSS 2.0 8.2.1 e), 8.8.4, 8.8.5: the domain of the element type of a set, and of the key and
// value types of a map, holds for every element, key and value.
component pss_top {
    action root_a {
        set<bit[8] in [1..3]>                    s = {1, 3};
        map<bit[8] in [10..12], int in [-1..1]>  m = {10 : -1, 12 : 1};
        int ns = 0;
        int nm = 0;
        exec post_solve {
            ns = s.size();
            nm = m.size();
        }
        exec body ASM = """s={{ns}} m={{nm}}""";
    }
}
