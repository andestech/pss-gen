// Domains of integer fields: mixed range items, several instantiations, arrays.
component pss_top {
    action root_a {
        rand bit[8] in [1..3, 10.., 5..7, ..200] a, b;
        rand int in [0..7] c[2];
        rand bit[8] in [..9, 20..] e;
        rand bit[4] d = 2;
        rand bit[12:4] w;
        list<bit[4] in [1..2]> l;
        exec body ASM = """{{a}} {{b}} {{e}}""";
    }
}
