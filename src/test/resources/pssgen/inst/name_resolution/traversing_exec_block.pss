// An exec block of sub_a names a field of root_a, the action that traverses it, which sub_a does not see.
component pss_top {
    action root_a {
        bit[5] root_val = 7;
        activity {
            do sub_a;
        }
    }
    action sub_a {
        bit[8] v = 0;
        exec post_solve {
            v = root_val + 1;
        }
        exec body ASM = """v={{v}}""";
    }
}
