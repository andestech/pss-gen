// An activity of mid_a names a field of root_a, the action that traverses it, which mid_a does not see.
component pss_top {
    action root_a {
        bit[4] n = 2;
        activity {
            do mid_a;
        }
    }
    action mid_a {
        activity {
            repeat (n) {
                do leaf_a;
            }
        }
    }
    action leaf_a {
        exec body ASM = """leaf""";
    }
}
